{
	email ops@example.org
}

www.example.org, example.org {
	encode zstd gzip
	# The app already sends CSP, Referrer-Policy, X-Frame-Options, X-Content-Type-Options
	# and Permissions-Policy. HSTS is the proxy's, because only it knows TLS terminated here.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
	reverse_proxy 127.0.0.1:3000
}

# A staging host serves real content and a live admin panel, so put it behind a
# password. `caddy hash-password` prints the hash; the plaintext never lands here.
# Caddy answers the ACME challenge from its own handler, ahead of this, so
# certificates still issue and renew.
#
# dev.example.org {
# 	encode zstd gzip
# 	header {
# 		X-Robots-Tag "noindex, nofollow"
# 		-Server
# 	}
# 	basic_auth {
# 		someone $2a$14$...
# 	}
# 	reverse_proxy 127.0.0.1:3000
# }

