# Set to "production" when deploying. Enables Secure session cookies, the
# Content-Security-Policy, and makes the app refuse to boot with the insecure
# default AUTH_SECRET.
NODE_ENV=development

# Public site origin (no trailing slash), e.g. https://www.example.org.
# When set, enables <link rel=canonical> + hreflang alternates and absolute
# Open Graph image URLs. The VITE_ prefix exposes it to the SSR/client head.
VITE_SITE_URL=

# Local SQLite database file (Bun's built-in SQL engine).
# Use an ABSOLUTE path in production so the file (and login sessions) survive
# restarts regardless of the working directory / container layout.
# Read by the app AND by drizzle-kit (db:migrate, db:push, db:studio); leaving it
# unset in one shell and set in another is how migrations land on the wrong file.
DATABASE_PATH=./cms.db

# Host header allowlist for `bun run start` (vite preview), comma separated, e.g.
# www.example.org,example.org. Unset means every request is refused with
# "Blocked request". Not used by `bun run dev`.
ALLOWED_HOSTS=

# Secret that signs session JWTs. REQUIRED in production. Generate ONCE and keep
# it CONSTANT — if it changes between restarts/deploys, every existing login is
# invalidated:
#   bun -e "console.log(Array.from(crypto.getRandomValues(new Uint8Array(48))).map(b=>b.toString(16).padStart(2,'0')).join(''))"
AUTH_SECRET=

# Name of the proxy header carrying the real client IP, e.g. cf-connecting-ip
# (Cloudflare) or x-forwarded-for (nginx/Caddy/Traefik).
#
# LEAVE THIS EMPTY unless a reverse proxy or CDN sits in front AND the app cannot
# be reached around it. Login and form rate limits key on the client address; any
# such header is set by the caller, so trusting one on an app that is reachable
# directly lets an attacker rotate it for unlimited password guesses, or claim
# someone else's address to throttle them.
#
# Empty (the default) uses the socket peer address, which cannot be forged. Note
# that with a proxy in front and this unset, every visitor shares ONE rate-limit
# bucket — in production the app warns when it detects that.
#
# The header is read RIGHTMOST-first: x-forwarded-for is a chain and appending
# proxies produce "<caller-supplied>, <real client>", so only the last entry is
# trustworthy. Single-value headers like cf-connecting-ip are unaffected.
TRUSTED_PROXY_HEADER=

# --- First install (`bun run db:seed`) -------------------------------------
# Read once, when the database is empty. Changing them later does nothing; edit
# the site in /admin instead.

# Site name. Becomes the tenant name and the footer's site_name_en.
SITE_NAME=

# Default language. Must be one of the codes in LANGS (src/lib/i18n-config.ts),
# because the router only serves language prefixes listed there.
SITE_DEFAULT_LANG=en

# The first administrator. Leave ADMIN_PASSWORD empty and the installer generates
# one and prints it once — nothing is stored in the source or the image.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Cloudflare R2 (S3-compatible object storage) for media uploads.
# Without these, uploads fall back to the local public/uploads/ directory.
# Find the account id and create an API token in the Cloudflare R2 dashboard.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public base URL for serving objects (custom domain or *.r2.dev). Optional.
R2_PUBLIC_URL=

# SMTP for the contact form. Optional — when unset, submissions are still stored
# in the database and the email body is logged instead of sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Sender address (defaults to SMTP_USER) and where contact emails are delivered.
# With MAIL_TO unset, submissions are stored and logged but nothing is sent.
MAIL_FROM=
MAIL_TO=

# Baray payment gateway (https://baray.io) for donations. Create an org at
# https://dash.baray.io and generate keys (shown only once). All three are
# required to accept donations; when unset the donate page returns a clear
# "not configured" message. SK is a Base64 32-byte key, IV a Base64 16-byte IV.
BARAY_API_KEY=
BARAY_SK=
BARAY_IV=
# Endpoints — override only for sandbox/testing. Defaults shown.
# BARAY_API_URL=https://api.baray.io
# BARAY_PAY_URL=https://pay.baray.io
