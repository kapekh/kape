# Local SQLite database file (Bun's built-in SQL engine).
# Use an ABSOLUTE path in production so the file (and login sessions) survive
# restarts regardless of the working directory / container layout.
DATABASE_PATH=./kape.db

# Secret that signs session JWTs. Generate ONCE and keep it CONSTANT — if it
# changes between restarts/deploys, every existing login is invalidated:
#   bun -e "console.log(Array.from(crypto.getRandomValues(new Uint8Array(48))).map(b=>b.toString(16).padStart(2,'0')).join(''))"
AUTH_SECRET=

# Cloudflare R2 (S3-compatible object storage)
# Find the account id and create an API token in the Cloudflare R2 dashboard.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public base URL for serving objects (custom domain or *.r2.dev). Optional.
R2_PUBLIC_URL=
