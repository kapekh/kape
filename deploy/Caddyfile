{
	email ops@example.org
}

www.example.org, example.org {
	encode zstd gzip
	# The app already sends CSP, Referrer-Policy, X-Frame-Options, X-Content-Type-Options
	# and Permissions-Policy. HSTS is the proxy's, because only it knows TLS terminated here.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
	reverse_proxy 127.0.0.1:3000
}

# Serving both names means two URLs for every page. If you prefer one, replace
# the block above with these two and set VITE_SITE_URL to the surviving name.
#
# www.example.org {
# 	encode zstd gzip
# 	reverse_proxy 127.0.0.1:3000
# }
#
# example.org {
# 	redir https://www.example.org{uri} permanent
# }
