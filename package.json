{
  "name": "koompi-cms",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "PORT=${PORT:-3000} bun --bun vite dev --port ${PORT:-3000}",
    "generate-routes": "tsr generate",
    "build:app": "NODE_ENV=production bun --bun vite build",
    "build": "bun scripts/gen-prerender-paths.ts && bun run build:app",
    "prerender": "bun run build && bun scripts/prerender-static.ts",
    "preview": "bun --bun vite preview",
    "start": "NODE_ENV=production bun server.ts",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:seed": "bun src/server/install.ts",
    "db:seed:dev": "bun src/server/install.ts --dev",
    "seed:kape": "bun src/server/seed/kape.ts",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "format": "biome format",
    "lint": "biome lint",
    "check": "bunx tsc --noEmit && biome check && vitest run"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/match-sorter-utils": "latest",
    "@tanstack/react-devtools": "latest",
    "@tanstack/react-form": "latest",
    "@tanstack/react-query": "latest",
    "@tanstack/react-query-devtools": "latest",
    "@tanstack/react-router": "latest",
    "@tanstack/react-router-devtools": "latest",
    "@tanstack/react-router-ssr-query": "latest",
    "@tanstack/react-start": "latest",
    "@tanstack/react-table": "latest",
    "@tanstack/router-plugin": "^1.132.0",
    "@tiptap/core": "^3.26.1",
    "@tiptap/extension-image": "^3.26.1",
    "@tiptap/extension-link": "^3.26.1",
    "@tiptap/extension-table": "3.26.1",
    "@tiptap/react": "^3.27.0",
    "@tiptap/starter-kit": "^3.26.1",
    "@tiptap/static-renderer": "^3.26.1",
    "@trpc/client": "^11.11.0",
    "@trpc/server": "^11.11.0",
    "@trpc/tanstack-react-query": "^11.11.0",
    "@xyflow/react": "^12.11.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.8.3",
    "jose": "^6.2.3",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.577.0",
    "nodemailer": "^9.0.0",
    "radix-ui": "^1.6.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "superjson": "^2.2.2",
    "tailwind-merge": "^3.0.2",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.3.6",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.5",
    "@libsql/client": "^0.17.4",
    "@rolldown/plugin-babel": "^0.2.3",
    "@tailwindcss/typography": "^0.5.16",
    "@tanstack/devtools-vite": "latest",
    "@tanstack/router-cli": "^1.132.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.0",
    "@types/bun": "^1.3.4",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "drizzle-kit": "^0.31.10",
    "jsdom": "^28.1.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "^4.1.5"
  },
  "trustedDependencies": [
    "esbuild",
    "lightningcss"
  ]
}
